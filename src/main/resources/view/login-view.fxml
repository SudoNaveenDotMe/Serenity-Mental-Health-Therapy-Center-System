<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="600.0" prefWidth="850.0" styleClass="login-root" stylesheets="@../css/login.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.the_seranity_mental_health_therapy_center.controller.LoginController">
    <children>
        <!-- Decorative background circles -->
        <VBox styleClass="bg-decoration" StackPane.alignment="TOP_LEFT" />
        <VBox styleClass="bg-decoration-2" StackPane.alignment="BOTTOM_RIGHT" />

        <!-- Main Glass Card -->
        <VBox alignment="CENTER" maxHeight="520.0" maxWidth="420.0" spacing="28.0" styleClass="glass-card" StackPane.alignment="CENTER">
            <children>
                <!-- Logo / Header -->
                <VBox alignment="CENTER" spacing="10.0">
                    <children>
                        <HBox alignment="CENTER" spacing="8.0">
                            <children>
                                <Label styleClass="login-title" text="SERENITY" />
                            </children>
                        </HBox>
                        <Label styleClass="login-subtitle" text="Mental Health Therapy Center" />
                        <Label styleClass="login-hint" text="Please sign in to continue" />
                    </children>
                </VBox>

                <!-- Form Fields -->
                <VBox spacing="20.0">
                    <children>
                        <VBox spacing="6.0">
                            <children>
                                <Label styleClass="field-label" text="Username" />
                                <TextField fx:id="txtUsername" prefHeight="48.0" promptText="Enter your username" styleClass="modern-field" />
                            </children>
                        </VBox>
                        <VBox spacing="6.0">
                            <children>
                                <Label styleClass="field-label" text="Password" />
                                <PasswordField fx:id="txtPassword" prefHeight="48.0" promptText="Enter your password" styleClass="modern-field" />
                            </children>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets left="10.0" right="10.0" />
                    </VBox.margin>
                </VBox>

                <!-- Sign In Button -->
                <Button mnemonicParsing="false" onAction="#btnLoginOnAction" prefHeight="50.0" prefWidth="340.0" styleClass="btn-signin" text="SIGN IN" />

                <!-- Footer -->
                <Label styleClass="footer-text" text="© 2026 Serenity Therapy Center. All rights reserved." />
            </children>
            <padding>
                <Insets bottom="42.0" left="42.0" right="42.0" top="42.0" />
            </padding>
        </VBox>
    </children>
</StackPane>
