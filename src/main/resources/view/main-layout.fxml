<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="768.0" prefWidth="1280.0" styleClass="main-layout-root" stylesheets="@../css/main-layout.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.the_seranity_mental_health_therapy_center.controller.MainLayoutController">
   <left>
      <VBox prefWidth="260.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <!-- Brand Header -->
            <VBox alignment="CENTER_LEFT" prefHeight="120.0" spacing="8.0" styleClass="sidebar-header">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label styleClass="brand-icon" text="🌿" />
                        <Label styleClass="brand-title" text="Serenity" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="6.0">
                     <children>
                        <Label styleClass="online-dot" text="●" />
                        <Label fx:id="lblRole" styleClass="role-label" text="Logged in as: Manager" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
               </padding>
            </VBox>

            <!-- Navigation Menu -->
            <VBox spacing="4.0" styleClass="nav-menu" VBox.vgrow="ALWAYS">
               <children>
                  <Button mnemonicParsing="false" onAction="#btnDashboardOnAction" prefHeight="48.0" prefWidth="260.0" styleClass="nav-btn" text="Dashboard" />
                  <Button mnemonicParsing="false" onAction="#btnPatientOnAction" prefHeight="48.0" prefWidth="260.0" styleClass="nav-btn" text="Patients" />
                  <Button mnemonicParsing="false" onAction="#btnSessionOnAction" prefHeight="48.0" prefWidth="260.0" styleClass="nav-btn" text="Sessions" />
                  <Button mnemonicParsing="false" onAction="#btnRegistrationOnAction" prefHeight="48.0" prefWidth="260.0" styleClass="nav-btn" text="Registrations" />
                  <Button mnemonicParsing="false" onAction="#btnPaymentOnAction" prefHeight="48.0" prefWidth="260.0" styleClass="nav-btn" text="Payments" />
                  <Button fx:id="btnTherapist" mnemonicParsing="false" onAction="#btnTherapistOnAction" prefHeight="48.0" prefWidth="260.0" styleClass="nav-btn" text="Therapists" />
                  <Button fx:id="btnProgram" mnemonicParsing="false" onAction="#btnProgramOnAction" prefHeight="48.0" prefWidth="260.0" styleClass="nav-btn" text="Programs" />
               </children>
               <padding>
                  <Insets bottom="8.0" left="12.0" right="12.0" top="8.0" />
               </padding>
            </VBox>

            <!-- Logout Footer -->
            <VBox styleClass="sidebar-footer">
               <children>
                  <Button mnemonicParsing="false" onAction="#btnLogoutOnAction" prefHeight="52.0" prefWidth="130.0" styleClass="logout-btn" text="Logout System" />
               </children>
               <padding>
                  <Insets bottom="20.0" left="12.0" right="12.0" top="12.0" />
               </padding>
            </VBox>
         </children>
      </VBox>
   </left>
   <center>
      <BorderPane fx:id="contentPane" styleClass="content-area" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
         </padding>
      </BorderPane>
   </center>
</BorderPane>
